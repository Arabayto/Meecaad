{
  "name": "meecaad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply meecaad --local",
    "db:migrate:remote": "wrangler d1 migrations apply meecaad --remote",
    "db:backup": "wrangler d1 export meecaad --remote --output backups/meecaad-$(date +%Y%m%d-%H%M%S).sql",
    "test": "node tests/run.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=meecaad"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.156.0"
  }
}
